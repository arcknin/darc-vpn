FROM golang:1.25.1-bookworm@sha256:c423747fbd96fd8f0b1102d947f51f9b266060217478e5f9bf86f145969562ee AS build
WORKDIR /src
COPY back-vpn/go.mod back-vpn/go.sum ./
RUN go mod download
COPY back-vpn/ ./
RUN CGO_ENABLED=1 go build -trimpath -o /api ./cmd/api && CGO_ENABLED=1 go build -trimpath -o /legacy-import ./cmd/legacy-import
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /api /app/api
COPY --from=build /legacy-import /app/legacy-import
COPY infra/wireguard-stack/api-entrypoint.sh /app/entrypoint.sh
ENTRYPOINT ["/app/entrypoint.sh"]
